#!/usr/bin/env python3
"""Restricted SSH entry point. All paths and the sg command are fixed."""
import fcntl
import grp
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path('/srv/agents/game')
COMMAND = re.compile(r'deploy (staging|production) ([0-9a-f]{40})', re.ASCII)


class Refused(Exception):
    pass


def git(src, *args):
    result = subprocess.run(['git', '-C', str(src), *args], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, check=False)
    if result.returncode:
        reasons = {'fetch': 'fetch origin/main failed',
                   'merge-base': 'target SHA is not reachable from origin/main',
                   'checkout': 'target checkout failed'}
        raise Refused(reasons.get(args[0], 'git operation failed'))


def docker_group():
    gid = grp.getgrnam('docker').gr_gid
    return gid == os.getegid() or gid in os.getgroups()


def deploy(command):
    match = COMMAND.fullmatch(command)
    if not match:
        raise Refused('expected deploy <staging|production> <40 lowercase hex>')
    env, sha = match.groups()
    if not docker_group():
        # No user input appears in this command. sg preserves SSH_ORIGINAL_COMMAND.
        os.execvp('sg', ['sg', 'docker', '-c', '/srv/agents/game/bin/deploy-gate'])
    directory = ROOT / env
    with (directory / 'deploy.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        src = directory / 'src'
        git(src, 'fetch', '--quiet', 'origin', '+refs/heads/main:refs/remotes/origin/main')
        git(src, 'merge-base', '--is-ancestor', sha, 'origin/main')
        if env == 'production':
            log = ROOT / 'staging/deployed.log'
            entries = log.read_text().splitlines() if log.exists() else []
            if not any(len(fields := line.split()) == 2 and fields[1] == sha for line in entries):
                raise Refused('production SHA has no successful staging deployment')
        git(src, 'checkout', '--quiet', '--detach', sha)
        script = src / 'deploy/deploy.sh'
        if not script.is_file() or not os.access(script, os.X_OK):
            raise Refused('target checkout lacks executable deploy/deploy.sh')
        os.set_inheritable(lock.fileno(), True)
        os.chdir(src)
        os.execv(str(script), [str(script), env, sha])


def main():
    # SSH callers may use 077; checkout files must be readable by container users.
    os.umask(0o022)
    try:
        deploy(os.environ.get('SSH_ORIGINAL_COMMAND', ''))
    except Refused as error:
        # Refused reasons are constant strings; never include command data.
        print(f'deploy-gate: refused: {error}', file=sys.stderr)
        return 2
    except (OSError, KeyError):
        # Deliberately omit exception text: it may contain untrusted input/secrets.
        print('deploy-gate: refused (invalid command, unavailable checkout or admission failed)', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
